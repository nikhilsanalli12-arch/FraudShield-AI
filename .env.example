# ==============================================================================
# FraudShield AI — Unified Environment Configuration Template
# ==============================================================================
# NOTE: Never commit production credentials, service-role keys, or private tokens.
# Copy this file to .env (or module-specific .env files) during configuration.

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite Client)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api/v1
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key
VITE_APP_ENV=development

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (Express.js API Gateway)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
SUPABASE_URL=https://your-project.supabase.co
# CRITICAL: Service role key must NEVER be exposed to the client/frontend
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
AI_SERVICE_URL=http://localhost:8000
INTERNAL_API_SECRET=dev-secret-token-change-in-production
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# ------------------------------------------------------------------------------
# AI ENGINE CONFIGURATION (FastAPI Microservice)
# ------------------------------------------------------------------------------
FASTAPI_PORT=8000
AI_ENV=development
INTERNAL_AUTH_TOKEN=dev-secret-token-change-in-production
MODEL_ARTIFACTS_DIR=artifacts/

